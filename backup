Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  config.vm.provider "qemu" do |qe|
    qe.arch       = "x86_64"
    qe.machine    = "q35"
    qe.cpu        = "qemu64"
    qe.net_device = "virtio-net-pci"
    qe.memory     = "2G"
    qe.smp        = "2"
    qe.ssh_port   = "50022"

    # Custom QEMU shared directory for Linux Mint
    qe.qemu_dir   = "/usr/share/qemu"
  end
end
